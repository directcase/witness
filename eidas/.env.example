# Copy to .env (never committed) and adjust. All values are optional.

# Card preset: ee (Estonia, via DigiDoc4/OpenSC), sk (Slovakia, macOS keychain), opensc (any OpenSC-supported card)
ESIGN_CARD=ee

# Path to a PKCS#11 module - overrides ESIGN_CARD. Use this for other countries' vendor middleware.
# ESIGN_LIB=/path/to/pkcs11-module.so

# Signing PIN (e.g. Estonian PIN2). Leave empty to be asked each time.
# Ignored for cards that ask for the PIN in their own dialog or on the reader (e.g. Slovak eID).
ESIGN_PIN=

# Part of the certificate name/issuer to pick when several signing certificates are present.
# ESIGN_CERT=

# RFC 3161 timestamp server (default: http://timestamp.digicert.com, free but not EU-qualified).
# ESIGN_TSA=
